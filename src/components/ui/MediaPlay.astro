---
/**
 * Botón circular de reproducción sobre una imagen (simulación 3D, testimonio).
 * Solo se pinta si hay URL de vídeo: sin vídeo, la imagen se muestra tal cual
 * (decisión del cliente, 13/11/2026: no mostrar un icono de play sin vídeo).
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  label: string;
  variant: 'sim' | 'testimonial';
}

const { href, label, variant } = Astro.props;
const icon = variant === 'sim' ? 'play' : 'play-testimonial';
---

{
  href && (
    <a class:list={['play', `play--${variant}`]} href={href} target="_blank" rel="noopener" aria-label={label}>
      <Icon name={icon} class="play__icon" />
    </a>
  )
}

<style>
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-4);
    border-radius: 50%;
    background: var(--color-bg-page);
    transform: translate(-50%, -50%);
  }
  .play--sim {
    width: 60px;
    height: 60px;
  }
  .play--testimonial {
    width: 64px;
    height: 64px;
  }
  .play :global(.play__icon svg) {
    width: 20px;
    height: 20px;
  }
  .play--testimonial :global(.play__icon svg) {
    width: 21px;
    height: 21px;
  }
  @media (min-width: 1024px) {
    .play--sim {
      width: 84px;
      height: 84px;
    }
    .play--testimonial {
      width: 76px;
      height: 76px;
    }
    .play--sim :global(.play__icon svg) {
      width: 28px;
      height: 28px;
    }
    .play--testimonial :global(.play__icon svg) {
      width: 25px;
      height: 25px;
    }
  }
</style>
