---
/**
 * Antes y después (Figma 22:380 / móvil 10:105).
 * Escritorio: rejilla 3×2. Móvil: carrusel con scroll-snap + indicadores pulsables
 * (deslizar con el dedo o pulsar un punto; los puntos también funcionan con teclado/ratón).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { TextoResponsive } from '../../lib/content';

interface Caso {
  imagen: ImageMetadata;
  alt: string;
  titulo: string;
  detalle: string;
}

interface Props {
  /** Fondo: lo asigna la plantilla alternando según la posición. */
  tone?: "light" | "tint";
  eyebrow: string;
  titulo: string;
  intro: TextoResponsive;
  cta_label: string;
  ctaHref: string;
  casos: Caso[];
  aviso: string;
}

const { eyebrow, titulo, intro, cta_label, ctaHref, casos, aviso } = Astro.props;
const { tone = "light" } = Astro.props;
---

<section class:list={["section", "ba", { "section--tint": tone === "tint" }]} aria-labelledby="ba-title">
  <div class="container">
    <div class="ba__head">
      <SectionHeading id="ba-title" eyebrow={eyebrow} title={titulo} intro={intro} />
      <Button class="only-desktop" variant="outline" icon="arrow" href={ctaHref}>{cta_label}</Button>
    </div>

    <ul class="ba__grid" id="ba-casos" data-carousel>
      {
        casos.map((caso) => (
          <li class="ba-card">
            <figure>
              <div class="ba-card__media">
                <Image
                  src={caso.imagen}
                  alt={caso.alt}
                  widths={[384, 768]}
                  sizes="(min-width: 1024px) 384px, 300px"
                  loading="lazy"
                />
                <span class="ba-card__tag ba-card__tag--before t-tag">Antes</span>
                <span class="ba-card__tag ba-card__tag--after t-tag">Después</span>
              </div>
              <figcaption class="ba-card__caption">
                <span class="t-h4 ba-card__title">{caso.titulo}</span>
                <span class="t-small ba-card__detail">{caso.detalle}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="ba__dots only-mobile" role="group" aria-label="Elegir caso" data-carousel-dots>
      {
        casos.map((_, i) => (
          <button
            type="button"
            class:list={['ba__dot', { 'is-active': i === 0 }]}
            aria-label={`Caso ${i + 1} de ${casos.length}`}
            aria-controls="ba-casos"
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))
      }
    </div>

    <p class="ba__mobile-cta only-mobile">
      <a class="ba__link t-body-semibold" href={ctaHref}>
        {cta_label}
        <Icon name="arrow-link" />
      </a>
    </p>

    <!-- El frame móvil no muestra este aviso; se mantiene en todos los tamaños por precaución sanitaria (CLAUDE.md §8). -->
    <p class="ba__aviso t-small">{aviso}</p>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((track) => {
    const dots = track.parentElement?.querySelectorAll<HTMLButtonElement>('[data-carousel-dots] > button');
    if (!dots?.length) return;
    const cards = Array.from(track.children) as HTMLElement[];
    // Posición de cada tarjeta dentro del carrusel (independiente del offsetParent).
    const cardLeft = (i: number) => cards[i].offsetLeft - cards[0].offsetLeft;

    const setActive = (active: number) => {
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        if (i === active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const update = () => {
      const left = track.scrollLeft;
      let active = 0;
      let best = Infinity;
      cards.forEach((_, i) => {
        const d = Math.abs(cardLeft(i) - left);
        if (d < best) {
          best = d;
          active = i;
        }
      });
      setActive(active);
    };

    track.addEventListener('scroll', update, { passive: true });

    // Pulsar un punto lleva a su caso (ratón, teclado o toque).
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        track.scrollTo({ left: cardLeft(i), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      });
    });
  });
</script>

<style>
  .ba__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-24);
  }
  .ba__head :global(.heading) {
    max-width: 760px;
  }

  /* Móvil: carrusel horizontal que sangra hasta el borde derecho */
  .ba__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 300px;
    gap: 12px;
    margin-top: 28px;
    margin-right: calc(-1 * var(--gutter));
    padding-right: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .ba__grid::-webkit-scrollbar {
    display: none;
  }

  .ba-card {
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-bg-page);
  }
  .ba-card__media {
    position: relative;
    height: 240px;
    overflow: hidden;
  }
  .ba-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-card__tag {
    position: absolute;
    top: 12px;
    padding: 5px 10px;
    border-radius: 2px;
    background: var(--color-bg-page);
    color: var(--color-text-primary);
  }
  .ba-card__tag--before {
    left: 12px;
  }
  .ba-card__tag--after {
    left: calc(50% + 51.5px);
    transform: translateX(-50%);
  }
  .ba-card__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-16);
  }
  .ba-card__title {
    color: var(--color-text-primary);
  }
  .ba-card__detail {
    color: var(--color-text-muted);
  }

  /* Separación visual de 6px entre puntos (Figma) = 3px de padding a cada lado del botón;
     el padding amplía el área pulsable sin cambiar el aspecto. */
  .ba__dots {
    display: flex;
    justify-content: center;
    padding-top: 12px;
  }
  .ba__dot {
    display: flex;
    align-items: center;
    padding: 8px 3px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .ba__dot::before {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: var(--color-bg-muted);
    content: '';
    transition: width 0.2s ease;
  }
  .ba__dot.is-active::before {
    width: 22px;
    background: var(--color-bg-dark);
  }
  .ba__dot:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .ba__dot::before {
      transition: none;
    }
  }

  .ba__mobile-cta {
    display: flex;
    justify-content: center;
    padding-top: 12px;
  }
  .ba__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-accent);
    color: var(--color-text-primary);
  }

  .ba__aviso {
    padding-top: var(--space-24);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .ba__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 24px;
      margin-right: 0;
      padding-right: 0;
      overflow: visible;
    }
    .ba__dots {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .ba__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 56px;
    }
  }
</style>
