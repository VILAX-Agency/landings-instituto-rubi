---
/** Testimonios (Figma 22:686 / móvil 10:362). Review card 20:86. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import StarRating from '../ui/StarRating.astro';
import MediaPlay from '../ui/MediaPlay.astro';

interface Props {
  /** Fondo: lo asigna la plantilla alternando según la posición. */
  tone?: "light" | "tint";
  eyebrow: string;
  titulo: string;
  video: { imagen: ImageMetadata; alt: string; nombre: string; detalle: string; video_url?: string };
  resenas: { cita: string; autor: string; ocultar_movil?: boolean }[];
}

const { eyebrow, titulo, video, resenas } = Astro.props;
const { tone = "light" } = Astro.props;
---

<section class:list={["section", "testi", { "section--tint": tone === "tint" }]} aria-labelledby="testi-title">
  <div class="container">
    <SectionHeading id="testi-title" eyebrow={eyebrow} title={titulo} />

    <div class="testi__layout">
      <figure class="testi__video">
        <Image src={video.imagen} alt={video.alt} widths={[335, 400, 800]} sizes="(min-width: 1024px) 400px, 100vw" loading="lazy" />
        <MediaPlay href={video.video_url} label={`Ver el testimonio de ${video.nombre}`} variant="testimonial" />
        <figcaption class="testi__caption">
          <span class="testi__name">{video.nombre}</span>
          <span class="testi__detail">{video.detalle}</span>
        </figcaption>
      </figure>

      <div class="testi__reviews">
        {
          resenas.map((r) => (
            <blockquote class:list={['review', { 'only-desktop': r.ocultar_movil }]}>
              <StarRating icon="star-review" size={16} />
              <p class="t-body-italic review__quote">{r.cita}</p>
              <footer class="t-small review__author">{r.autor}</footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .testi__layout {
    display: flex;
    flex-direction: column;
    padding-top: 28px;
  }
  .testi__video {
    position: relative;
    height: 440px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-media);
  }
  .testi__video :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .testi__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 18px 20px;
    background: var(--color-bg-dark);
  }
  .testi__name {
    color: var(--color-text-on-dark);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 28px;
  }
  .testi__detail {
    color: var(--color-text-on-dark-muted);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
  }
  .testi__reviews {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 20px;
  }
  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-24);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-bg-input);
  }
  .review__quote {
    color: var(--color-text-primary);
  }
  .review__author {
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .testi__layout {
      flex-direction: row;
      gap: 40px;
      padding-top: 48px;
    }
    .testi__video {
      flex: 0 0 400px;
      height: 560px;
    }
    .testi__caption {
      padding: var(--space-24);
    }
    .testi__name {
      font-size: 24px;
      line-height: 32px;
    }
    .testi__detail {
      padding-top: 2px;
      font-size: 14px;
      line-height: 20px;
    }
    .testi__reviews {
      flex: 760 1 0;
      justify-content: center;
      gap: var(--space-20);
      min-width: 0;
      padding-top: 0;
    }
  }
</style>
