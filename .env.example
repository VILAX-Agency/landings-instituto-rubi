# Copiar a .env.local (ignorado por Git). Nunca subir valores reales.
# Producción y Preview se configuran en Vercel (ver docs/despliegue.md).

# ---------- Públicas (se incluyen en el HTML/JS del navegador) ----------

# Origen de las landings (canonicals). Sin ruta ni barra final.
PUBLIC_SITE_URL=https://tratamiento.institutorubi.com

# Prefijo de URL de las landings (sin barras). Vacío = raíz del subdominio.
PUBLIC_LANDINGS_BASE=

# Incluir landings "borrador"/"pendiente_revision" e índice de previsualización.
# Producción: false.
PUBLIC_INCLUDE_DRAFTS=true

# Incluir landings ficticias de prueba (fixture: true). Producción: false.
PUBLIC_INCLUDE_FIXTURES=true

# Activa el envío real de los formularios. false = formulario "no operativo".
PUBLIC_LEADS_ENABLED=false

# Clave pública de Cloudflare Turnstile.
# Desarrollo/Preview: clave de prueba que siempre pasa (1x00000000000000000000AA).
PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Secretos de servidor (astro:env, nunca llegan al navegador) ----------

# Supabase (proyecto de DESARROLLO en local y Preview; producción solo en Vercel).
SUPABASE_URL=
# Clave secreta (formato sb_secret_...). Salta RLS: solo servidor.
SUPABASE_SECRET_KEY=

# Resend
RESEND_API_KEY=
# Remitente verificado, p. ej. "Instituto Rubí <leads@notificaciones.institutorubi.com>"
LEADS_EMAIL_FROM=
# Destinatarios separados por comas (recomendado: un único buzón compartido;
# el plan Free cuenta cada destinatario: 100 emails/día).
LEADS_EMAIL_TO=

# Cloudflare Turnstile. Desarrollo/Preview: 1x0000000000000000000000000000000AA (siempre pasa).
TURNSTILE_SECRET_KEY=

# Protege el cron de reintentos (Vercel lo envía como "Authorization: Bearer ...").
CRON_SECRET=
