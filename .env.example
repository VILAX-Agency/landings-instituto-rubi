# Prefijo de URL de las landings (sin barras). Aún sin decidir: "tratamientos", "campanas"...
# Vacío = landings en la raíz (/aumento-pecho/).
PUBLIC_LANDINGS_BASE=tratamientos

# Incluir landings en estado "borrador"/"pendiente_revision" en el build (previsualización).
# En un build de publicación debe ser "false".
PUBLIC_INCLUDE_DRAFTS=true

# Incluir landings ficticias de prueba (fixture: true). Nunca en publicación.
PUBLIC_INCLUDE_FIXTURES=true
