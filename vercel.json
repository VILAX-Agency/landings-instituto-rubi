{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/((?!api/|_astro/)(?:.*/)?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [{ "path": "/api/cron/notificaciones/", "schedule": "0 * * * *" }]
}
